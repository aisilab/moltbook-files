# Required for scripts/push_dataset.py (uploading the parquet to HuggingFace).
# Generate at https://huggingface.co/settings/tokens (write scope).
HF_TOKEN=

# Optional. Only needed for scripts/extras/new_langs.py, which runs LLM-based
# new-language detection against an OpenAI-compatible endpoint. The published
# `lang` field on the dataset comes from fastText (lid.176), not from this LLM.
# Set both if you want to reproduce the new-language signals dataset.
API_KEY=
API_BASE=
